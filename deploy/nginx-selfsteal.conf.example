# ============================================================
# 由 Reality Panel 生成 —— 重新生成会覆盖本文件
# 链路: Xray REALITY -> PROXY protocol -> 127.0.0.1:8003 -> 本地 TLS -> 反代 www.lovelive-anime.jp
# ============================================================

map $http_upgrade $reality_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 127.0.0.1:8003 ssl proxy_protocol http2;
    server_name node.example.com;

    # ---- 本地 TLS：证书必须与客户端 SNI 完全一致 ----
    ssl_certificate     /etc/letsencrypt/live/node.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/node.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:REALITY_TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # 只有本机 Xray 会连进来，PROXY protocol 里的源 IP 才是真实客户端
    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;
    real_ip_header proxy_protocol;

    # 不暴露这是代理：隐藏常见指纹头
    server_tokens off;
    proxy_hide_header Alt-Svc;
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Strict-Transport-Security;

    # ---- 上游真实站点 ----
    resolver 223.5.5.5 119.29.29.29 1.1.1.1 ipv6=off valid=300s;
    set $reality_upstream "www.lovelive-anime.jp";

    # ---- 订阅入口 ----
    # 普通 HTTPS 请求（浏览器 / 客户端拉订阅）没有 REALITY 认证数据，
    # 会被原样转到这个 server，于是同一个 443 域名也能提供订阅。
    location ^~ /sub/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass https://$reality_upstream$request_uri;
        proxy_http_version 1.1;

        # 上游也走 SNI，且证书按上游域名校验失败时不至于 502（上游本身是可信站点）
        proxy_ssl_server_name on;
        proxy_ssl_name $reality_upstream;

        proxy_set_header Host              $reality_upstream;
        proxy_set_header User-Agent        $http_user_agent;
        proxy_set_header Accept-Language   $http_accept_language;
        proxy_set_header Referer           https://www.lovelive-anime.jp$request_uri;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $reality_connection_upgrade;

        # 关掉压缩，sub_filter 才能改写 HTML 里的绝对链接
        proxy_set_header Accept-Encoding   "";

        # 把上游的绝对地址改写成当前域名，页面资源才不会漏到真实站点
        sub_filter_once off;
        sub_filter 'https://www.lovelive-anime.jp' 'https://$host';
        proxy_redirect ~^https?://www\.lovelive\-anime\.jp(/.*)?$ https://$host$1;

        proxy_buffering off;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }
}
