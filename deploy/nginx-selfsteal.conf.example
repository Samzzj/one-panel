# ============================================================
# 由 Reality Panel 生成 —— 重新生成会覆盖本文件
# 链路: Xray REALITY -> PROXY protocol -> 127.0.0.1:8003 -> 本地 TLS -> 静态站 /var/www/nav
# ============================================================

server {
    listen 127.0.0.1:8003 ssl proxy_protocol http2;
    server_name node.example.com;

    # ---- 本地 TLS：证书必须与客户端 SNI 完全一致 ----
    ssl_certificate     /etc/letsencrypt/live/node.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/node.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:REALITY_TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # 只有本机 Xray 会连进来，PROXY protocol 里的源 IP 才是真实客户端
    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;
    real_ip_header proxy_protocol;

    # 不暴露这是代理：隐藏常见指纹头
    server_tokens off;

    # ---- 订阅入口 ----
    # 普通 HTTPS 请求（浏览器 / 客户端拉订阅）没有 REALITY 认证数据，
    # 会被原样转到这个 server，于是同一个 443 域名也能提供订阅。
    location ^~ /sub/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }

    # ---- 本地静态站（deploy/nav-site.sh 部署）----
    root  /var/www/nav;
    index index.html;
    charset utf-8;

    gzip              on;
    gzip_min_length   1024;
    gzip_comp_level   4;
    gzip_types        text/plain text/css application/javascript application/json
                      image/svg+xml application/xml text/xml;

    # HTML 不缓存：改完内容立刻生效
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # 用站点自己的 404 页面，避免露出 nginx 默认页
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }

    location ~* \.(?:css|js|mjs|jpg|jpeg|png|gif|svg|webp|avif|ico|woff2?|ttf|eot|map)$ {
        expires 1h;
        add_header Cache-Control "public";
        access_log off;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
